# Lanyard Configuration
# Copy this file to .env and configure your desired keys/models.

# Active Vision Provider: gemini, openai, anthropic, ollama, openrouter
LANYARD_PROVIDER=gemini

# Google Gemini (Default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-vl-72b-instruct

# Ollama (Local / Air-Gapped)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl
